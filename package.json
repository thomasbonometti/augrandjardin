{
  "name": "au-grand-jardin-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node scripts/sync-notion.mjs && node scripts/fetch-agj.mjs",
    "build": "npm run sync && astro build",
    "build:local": "astro build",
    "dev": "astro dev",
    "preview": "wrangler pages dev dist --compatibility-date=2026-09-15",
    "test": "node --test tests/*.test.js",
    "e2e": "playwright test"
  },
  "dependencies": {
    "astro": "5.18.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "geist": "1.8.1",
    "wrangler": "4.151.1"
  }
}
