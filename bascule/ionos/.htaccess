# augrandjardin.fr (sans www), hébergement IONOS → nouveau site sur www.augrandjardin.fr (Cloudflare Pages).
# À déposer à la racine de l'espace web IONOS le jour du passage (plan : site-web/plan-bascule.md).
# Redirections définitives (301) qui gardent les paramètres de l'adresse (?src=qr…).
# Même correspondance que src/data/redirections.js.
RewriteEngine On

# Tant que www.augrandjardin.fr arrive encore ici (propagation DNS), ne pas le renvoyer vers lui-même.
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ - [L]

RewriteRule ^produits\.html$ https://www.augrandjardin.fr/produits/ [R=301,L]
RewriteRule ^(la-ferme|partenaires)\.html$ https://www.augrandjardin.fr/la-ferme/ [R=301,L]
RewriteRule ^actualites\.html$ https://www.augrandjardin.fr/ [R=301,L]
RewriteRule ^contact-horaires\.html$ https://www.augrandjardin.fr/horaires-contact/ [R=301,L]
RewriteRule ^mentions-legales\.html$ https://www.augrandjardin.fr/mentions-legales/ [R=301,L]
RewriteRule ^checkout\.html$ https://www.augrandjardin.fr/produits/ [R=301,L]
RewriteRule ^index\.html$ https://www.augrandjardin.fr/ [R=301,L]
# Le reste : la même adresse sur www. IONOS devine les pages .html (MultiViews) et réécrit $1 comme
# REQUEST_URI : augrandjardin.fr/produits/ devenait www…/produits.html/. THE_REQUEST (« GET /produits/?src=qr
# HTTP/1.1 ») garde l'adresse demandée ; NE : elle est déjà encodée, ne pas la réencoder.
RewriteCond %{THE_REQUEST} ^\S+\s+(/[^?\s]*)
RewriteRule ^ https://www.augrandjardin.fr%1 [R=301,L,NE]
