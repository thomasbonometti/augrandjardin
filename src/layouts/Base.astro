---
import '../styles/global.css';
import BarreInfo from '../components/BarreInfo.astro';
import Entete from '../components/Entete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import { ferme } from '../data/ferme.js';

interface Props {
  titre: string;
  description: string;
  page?: string;
  indexer?: boolean;
  schema?: object | object[];
  image?: string;
}
const { titre, description, page = '', indexer = true, schema, image = '/og.jpg' } = Astro.props;
// Tant que le site est en test (adresse *.pages.dev), rien n'est indexé : SITE_INDEXABLE=oui à la mise en ligne.
const indexable = indexer && import.meta.env.SITE_INDEXABLE === 'oui';
const canonique = new URL(Astro.url.pathname, Astro.site).href;
const imageAbsolue = new URL(image, Astro.site).href;
const schemas = schema ? [].concat(schema) : [];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titre}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonique} />
  {!indexable && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#0c4b31" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/Geist-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content={ferme.nom} />
  <meta property="og:title" content={titre} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonique} />
  <meta property="og:image" content={imageAbsolue} />
  <meta name="twitter:card" content="summary_large_image" />
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <script is:inline>
    // Apparitions au défilement : seulement si le visiteur accepte les animations.
    // Les éléments [data-anim] restent masqués jusqu'à leur entrée ; si GSAP ne se charge pas, tout réapparaît.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var r = document.documentElement;
      r.classList.add('anime');
      setTimeout(function () { if (!r.classList.contains('anime-pret')) r.classList.remove('anime'); }, 3000);
    }
  </script>
  <slot name="head" />
</head>
<body>
  <a class="lien-evitement" href="#contenu">Aller au contenu</a>
  <BarreInfo />
  <Entete page={page} />
  <main id="contenu" tabindex="-1">
    <slot />
  </main>
  <PiedDePage />
  <script src="../scripts/formulaires.ts"></script>
  <script>
    // GSAP n'est téléchargé que si les animations sont permises (classe posée dans <head>).
    if (document.documentElement.classList.contains('anime')) import('../scripts/animer').then((m) => m.animer()).catch(() => document.documentElement.classList.remove('anime'));
  </script>
  <script>
    // Menu mobile : ouverture, fermeture (bouton, Échap, lien), focus.
    const bouton = document.querySelector<HTMLButtonElement>('.burger');
    const menu = document.getElementById('menu-mobile');
    if (bouton && menu) {
      const ouvrir = (ouvert: boolean) => {
        bouton.setAttribute('aria-expanded', String(ouvert));
        bouton.setAttribute('aria-label', ouvert ? 'Fermer le menu' : 'Ouvrir le menu');
        const haut = (document.querySelector('.entete') as HTMLElement).getBoundingClientRect().bottom;
        menu.style.setProperty('--haut-menu', `${Math.max(0, haut)}px`);
        menu.hidden = !ouvert;
        document.body.classList.toggle('menu-ouvert', ouvert);
        if (ouvert) menu.querySelector<HTMLElement>('a')?.focus();
      };
      bouton.addEventListener('click', () => ouvrir(bouton.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && bouton.getAttribute('aria-expanded') === 'true') { ouvrir(false); bouton.focus(); }
      });
      menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) ouvrir(false); });
      matchMedia('(min-width: 1100px)').addEventListener('change', (m) => { if (m.matches) ouvrir(false); });
    }

    // Prochaine vente : si la date affichée est passée (site pas encore republié),
    // on garde le jour et l'heure sans la date.
    const fin = document.querySelector<HTMLElement>('[data-vente-fin]')?.dataset.venteFin;
    if (fin) {
      const p = Object.fromEntries(new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
        .formatToParts(new Date()).map((x) => [x.type, x.value]));
      const maintenant = `${p.year}-${p.month}-${p.day}T${p.hour}:${p.minute}`;
      if (maintenant > fin) {
        document.querySelectorAll<HTMLElement>('[data-vente-sans-date]').forEach((el) => { el.textContent = el.dataset.venteSansDate!; });
      }
    }
  </script>
</body>
</html>
