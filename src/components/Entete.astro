---
import Icone from './Icone.astro';
import Logo from './Logo.astro';
import { ferme, adresseComplete, lienProduits } from '../data/ferme.js';
import { prochaineVente as v, produits, fermeture, navigationAffichee as navigation } from '../lib/donnees.js';
interface Props { page?: string }
const { page = '' } = Astro.props;
const courant = (id: string) => (id === page ? 'page' : undefined);
const sansDate = v ? v.jour : '';
---
<header class="entete">
  <div class="wrap">
    <a class="entete__logo" href="/" aria-label="Au Grand Jardin, accueil"><Logo /></a>
    <nav class="entete__nav" aria-label="Navigation principale">
      {navigation.map((l) => <a href={l.href} aria-current={courant(l.id)}>{l.label}</a>)}
    </nav>
    <a class="btn btn-primaire entete__cta" href={lienProduits.href} aria-current={courant('produits')}>{lienProduits.label}</a>
    <div class="entete__actions">
      <a class="entete__cta-mobile" href={lienProduits.href} aria-current={courant('produits')}>Produits</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu-mobile" aria-label="Ouvrir le menu">
        <Icone nom="menu" taille={22} class="icone-menu" />
        <Icone nom="fermer" taille={22} class="icone-fermer" />
      </button>
    </div>
  </div>
</header>
<nav class="menu-mobile" id="menu-mobile" aria-label="Menu" hidden>
  <div class="wrap">
    <div class="menu-mobile__liens">
      <a href={lienProduits.href} aria-current={courant('produits')}>
        {lienProduits.label}<span class="chip chip-vif chip-petit">{fermeture ? 'En pause' : `${produits.length} produits`}</span>
      </a>
      {navigation.map((l) => (
        <a href={l.href} aria-current={courant(l.id)}>{l.label}<Icone nom="chevron" taille={20} /></a>
      ))}
    </div>
    {(v || fermeture) && (
      <div class="menu-mobile__vente">
        <div class="surtitre"><span class="point" aria-hidden="true"></span><p class="eyebrow">{fermeture ? 'Ventes en pause' : 'Prochaine vente'}</p></div>
        {fermeture
          ? <p class="quand">{fermeture.reprise ? <>Reprise le<br />{fermeture.repriseLong}</> : 'Reprise bientôt'}</p>
          : <p class="quand"><span data-vente-sans-date={sansDate}>{v.jourDate.replace(/^./, (c) => c.toUpperCase())}</span><br />{v.heures}</p>}
        <p class="sm muted">{adresseComplete}</p>
        <div class="btns">
          <a class="btn btn-primaire" href={ferme.itineraire} rel="noopener"><Icone nom="repere" taille={18} />Itinéraire</a>
          <a class="btn btn-secondaire" href={ferme.telephoneLien}><Icone nom="telephone" taille={18} />Appeler</a>
        </div>
      </div>
    )}
    <a class="menu-mobile__fb" href={ferme.facebook} rel="noopener"><Icone nom="facebook" taille={18} />Suivez la ferme sur Facebook</a>
  </div>
</nav>
<script>
  // Feuille du logo : un balancement complet au survol (souris) ou au focus clavier, jamais coupé ni relancé
  // en cours, pour éviter qu'elle saute en arrière quand la souris ne fait que passer. CSS : global.css.
  const logo = document.querySelector<HTMLAnchorElement>('.entete__logo');
  const calme = matchMedia('(prefers-reduced-motion: reduce)');
  const balancer = () => {
    if (!logo || calme.matches || logo.classList.contains('feuille-au-vent')) return;
    logo.classList.add('feuille-au-vent');
  };
  const poser = () => logo?.classList.remove('feuille-au-vent');
  logo?.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') balancer(); });
  logo?.addEventListener('focus', () => { if (logo.matches(':focus-visible')) balancer(); });
  logo?.addEventListener('animationend', poser);
  logo?.addEventListener('animationcancel', poser);
</script>
