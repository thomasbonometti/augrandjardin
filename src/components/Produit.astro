---
import { fmtEuro } from '../lib/site.js';
const { p, up = '' } = Astro.props;
const enPromo = p.promo && p.prixPromo != null;
const badges = [
  p.estNouveau && { t: 'Nouveau', c: 'new' },
  p.derniereSemaine && { t: 'Dernière semaine', c: 'warn' },
  p.quantiteLimitee && { t: 'Quantité limitée', c: 'warn' },
  enPromo && { t: 'Promo', c: 'warn' },
].filter(Boolean);
const initiale = p.nom.charAt(0);
---
<article class="produit">
  <div class="visuel">
    {p.image
      ? <img src={up + p.image} alt="" width="280" height="280" loading="lazy" decoding="async" />
      : <span class="initiale" aria-hidden="true">{initiale}</span>}
    {badges.length > 0 && <ul class="badges">{badges.map((b) => <li class={b.c}>{b.t}</li>)}</ul>}
  </div>
  <div class="infos">
    <h3>{p.nom}</h3>
    {p.prix && (
      <p class="prix">
        {enPromo ? <><s>{fmtEuro(p.prix.montant)}</s> <strong>{fmtEuro(p.prixPromo)}</strong></> : <strong>{fmtEuro(p.prix.montant)}</strong>}
        <span class="unite">{p.prix.unite}</span>
      </p>
    )}
    <p class="meta">
      {p.pasBio ? 'Non certifié bio' : 'Bio'}
      {p.producteur && p.producteur !== 'Au Grand Jardin' && <> · {p.producteur}</>}
      {p.prix?.auKg && <> · {fmtEuro(p.prix.auKg)} le kg</>}
    </p>
  </div>
</article>

<style>
  .produit { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .visuel { position: relative; aspect-ratio: 1 / 1; max-width: 100%; background: var(--leaf-soft); }
  .visuel img { width: 100%; height: 100%; object-fit: cover; }
  .initiale { position: absolute; inset: 0; display: grid; place-items: center; font: 700 3.5rem/1 var(--display); color: var(--leaf); opacity: 0.55; }
  .badges { position: absolute; left: 0.5rem; top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0; padding: 0; list-style: none; }
  .badges li { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; padding: 0.22rem 0.5rem; border-radius: 3px; background: var(--surface); color: var(--ink); }
  .badges li.new { background: var(--leaf); color: var(--leaf-ink); }
  .badges li.warn { background: var(--carrot); color: #fff; }
  .infos { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.75rem 0.85rem 0.9rem; flex: 1; min-width: 0; }
  .infos h3 { font-size: 1.08rem; }
  .prix { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.15rem 0.45rem; margin-top: 0.15rem; }
  .prix strong { font: 700 1.45rem/1.1 var(--display); font-variant-numeric: tabular-nums; color: var(--ink); }
  .prix s { color: var(--muted); }
  .unite { color: var(--muted); font-size: 0.95rem; }
  .meta { color: var(--muted); font-size: 0.85rem; margin-top: auto; padding-top: 0.25rem; }
</style>
