---
// Inscription à la liste SMS hebdomadaire → fonction /api/inscription-sms → base Notion « Inscriptions SMS ».
interface Props { source: string; variante?: 'sombre' | 'clair'; class?: string }
const { source, variante = 'sombre', class: classe = '' } = Astro.props;
const id = `sms-${source}`;
---
<form class={`form-sms form-sms--${variante} ${classe}`} action="/api/inscription-sms" method="post" data-form-api novalidate>
  <input type="hidden" name="source" value={source} />
  <div class="piege" aria-hidden="true"><label>Site web <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
  <div class="form-sms__ligne">
    <label class="visually-hidden" for={id}>Votre numéro de portable</label>
    <input class="saisie" id={id} name="telephone" type="tel" inputmode="tel" autocomplete="tel" placeholder="Votre numéro de portable" required pattern="[0-9 +().\-]{10,20}" aria-describedby={`${id}-msg ${id}-rgpd`} />
    <button class={`btn ${variante === 'sombre' ? 'btn-blanc' : 'btn-primaire'}`} type="submit">M’inscrire</button>
  </div>
  <p class="form-sms__rgpd xs" id={`${id}-rgpd`}>Un SMS par semaine au plus, de la ferme uniquement. Pour vous désinscrire, répondez STOP.</p>
  <p class="message-form" id={`${id}-msg`} role="status" aria-live="polite"></p>
</form>
<style>
  .form-sms { display: flex; flex-direction: column; gap: 10px; }
  .form-sms__ligne { display: flex; flex-direction: column; gap: 10px; }
  .form-sms__rgpd { color: var(--secondaire); }
  .form-sms--sombre .form-sms__rgpd { color: rgba(255, 255, 255, 0.72); }
  @media (min-width: 720px) {
    .form-sms__ligne { flex-direction: row; align-items: center; }
    .form-sms__ligne .saisie { width: 300px; }
    .form-sms--clair .form-sms__ligne .saisie { width: 280px; }
  }
</style>
