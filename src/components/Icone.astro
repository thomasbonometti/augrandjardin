---
// Icônes Lucide (licence ISC), les mêmes que dans les maquettes Figma.
interface Props { nom: string; taille?: number; epaisseur?: number; class?: string; titre?: string }
const { nom, taille = 20, epaisseur = 1.6, class: classe, titre } = Astro.props;
const chemins: Record<string, string> = {
