---
import Base from '../../layouts/Base.astro';
import { rayons, misAJour, fmtEuro } from '../../lib/site.js';
const TVA = 0.055;
// Démo : prix public ramené au HT. En production, une colonne « Prix pro HT » dans Notion.
const ht = (p) => (p.prix ? Math.round((p.prix.montant / (1 + TVA)) * 100) / 100 : null);
---
<Base
  title="Grille tarifaire professionnels | Au Grand Jardin"
  description="Grille tarifaire réservée aux clients professionnels."
  depth={1}
  page="pros"
  noindex
>
  <main class="wrap">
    <div class="intro">
      <p class="eyebrow">Espace professionnels · mis à jour {misAJour}</p>
      <h1>Grille tarifaire de la semaine</h1>
      <p class="lede">Prix hors taxes, TVA 5,5 %. Commandes par téléphone ou message avant le jour de récolte convenu.</p>
      <p class="demo-flag"><strong>Démo</strong> : ces prix sont les prix publics ramenés au HT. Pour de vrais prix pros, on ajoute une colonne « Prix pro HT » dans la base Produits de Notion, et seule cette page l’affiche.</p>
    </div>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th scope="col">Produit</th><th scope="col">Conditionnement</th><th scope="col" class="num">Prix HT</th><th scope="col" class="num">Prix TTC</th></tr>
        </thead>
        {rayons.map((r) => (
          <tbody>
            <tr class="rayon"><th scope="rowgroup" colspan="4">{r.titre}</th></tr>
            {r.items.map((p) => (
              <tr>
                <th scope="row">{p.nom}{p.quantiteLimitee && <span class="ql"> · quantité limitée</span>}</th>
                <td>{p.prix?.unite ?? '—'}</td>
                <td class="num"><strong>{ht(p) != null ? fmtEuro(ht(p)) : '—'}</strong></td>
                <td class="num ttc">{p.prix ? fmtEuro(p.prix.montant) : '—'}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </main>
</Base>

<style>
  .intro { display: flex; flex-direction: column; gap: 0.75rem; padding-block: 2.5rem 1.5rem; max-width: 52rem; }
  .table-scroll { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  th, td { padding: 0.6rem 0.9rem; text-align: left; border-top: 1px solid var(--line); white-space: nowrap; }
  tbody th { font-weight: 400; white-space: normal; }
  thead th { border-top: 0; font-size: 0.85rem; color: var(--muted); }
  tr.rayon th { font: 700 1.05rem/1.2 var(--display); background: var(--leaf-soft); color: var(--ink); }
  .num { text-align: right; }
  .ttc { color: var(--muted); }
  .ql { color: var(--carrot); font-size: 0.85rem; }
</style>
