---
// Accueil — frames Figma 13:2 (desktop) et 38:2 (mobile)
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Photo from '../components/Photo.astro';
import FormulaireSms from '../components/FormulaireSms.astro';
import QuestionsFrequentes from '../components/QuestionsFrequentes.astro';
import tampon from '../assets/svg/tampon.svg?raw';
import { ferme, adresseComplete } from '../data/ferme.js';
import { produits, rayons, vedettes, prochaineVente as v, creneaux, misAJour, agjCatalogue, fermeture, marchesAffiches, commandesPdtOuvertes } from '../lib/donnees.js';
import { euros, fmtHeure, plage } from '../lib/vente.js';
import { resumePdt } from '../lib/pdt.js';
import { schemaFerme } from '../lib/seo.js';

const nb = produits.length;
const pdt = resumePdt(agjCatalogue);
// Mode fermé : la commande en ligne est fermée elle aussi. Hors de la période de commande (case « Commandes
// de pommes de terre ouvertes » décochée), la carte Pommes de terre disparaît.
const pdtOuvert = pdt.ouvert && !fermeture;
const reprise = fermeture?.reprise ? `Reprise le ${fermeture.repriseLong}` : 'Reprise bientôt';
const description = fermeture
  ? `Légumes bio cueillis à Lostroff, 43 rue Principale. Ventes en pause : ${reprise.toLowerCase()}. Recevez la liste de la semaine pour être prévenu.`
  : `Légumes bio cueillis à Lostroff : ${nb} produits cette semaine, vente à la ferme${v ? ` ${v.jourDate} de ${v.heures}` : ''}, 43 rue Principale. ${commandesPdtOuvertes ? 'Pommes de terre en ligne, offre' : 'Offre'} pour les professionnels.`;
const samediFerme = creneaux.find((c) => c.aLaFerme && c.jour === 'Samedi');
const jourVente = v ? v.jour.toLowerCase() : 'samedi';
const autres = rayons.filter((r) => r.titre !== 'Divers').map((r) => r.titre.toLowerCase());
const autresTexte = autres.length > 1 ? `${autres.slice(0, -1).join(', ')} et ${autres.at(-1)}` : autres.join('');
const quand = v ? { jour: v.jourDate.replace(/^./, (c) => c.toUpperCase()), heures: `de ${fmtHeure(v.debut)} à ${fmtHeure(v.fin)}` } : null;
const tamponSvg = tampon.replace(/<\?xml[^>]*>/, '').replace('<svg', '<svg aria-hidden="true" focusable="false"');
---
<Base
  titre="Au Grand Jardin — maraîcher bio à Lostroff (Moselle), vente à la ferme le samedi"
  description={description}
  page="accueil"
  schema={schemaFerme(creneaux, { pommesDeTerre: commandesPdtOuvertes })}
>
  <!-- HERO -->
  <section class="wrap hero">
    <div class="hero__haut">
      <div class="hero__principal">
        <div class="surtitre" data-anim><span class="point" aria-hidden="true"></span><p class="eyebrow">Maraîcher bio · Lostroff<span class="seulement-ordi">, Moselle</span></p></div>
        <h1 data-anim="mots">Des légumes bio cueillis à Lostroff pour la vente du samedi</h1>
        <p class="lg muted hero__intro hero__intro--mobile" data-anim>Ferme certifiée bio par Ecocert, variétés choisies pour leur goût. Chaque semaine, Pierre publie ici ce qui est prêt à la récolte.</p>
        <div class="btns" data-anim>
          {fermeture
            ? <a class="btn btn-primaire btn-bloc" href="#sms">Être prévenu de la reprise</a>
            : <a class="btn btn-primaire btn-bloc" href="/produits/">Voir les {nb} produits de la semaine</a>}
          <a class="btn btn-secondaire btn-bloc" href="/horaires-contact/"><Icone nom="repere" taille={18} />Venir à la ferme</a>
        </div>
      </div>
      <p class="lg muted hero__intro hero__intro--ordi" data-anim>Ferme certifiée bio par Ecocert, variétés choisies pour leur goût. Chaque semaine, Pierre publie ici ce qui est prêt à la récolte.</p>
    </div>
    <dl class="stats" data-anim-groupe="monte">
      {fermeture
        ? <div><dt class="sm muted">reprise des ventes</dt><dd class="chiffre">{fermeture.reprise ? fermeture.repriseChiffre : 'Bientôt'}</dd></div>
        : <div><dt class="sm muted">produits cette semaine</dt><dd class="chiffre" data-compteur>{nb}</dd></div>}
      {v && <div><dt class="sm muted">prochaine vente{v.aLaFerme ? ', à la ferme' : ''}</dt><dd class="chiffre" data-compteur>{v.jourCourt}</dd></div>}
      <div><dt class="sm muted">légumes bio</dt><dd class="chiffre" data-compteur>100&nbsp;%</dd></div>
      <div class:list={[!fermeture && 'stat-ordi']}><dt class="sm muted">cultivé à la ferme</dt><dd class="chiffre" data-compteur>100&nbsp;%</dd></div>
      <div><dt class="sm muted">certifiée bio par Ecocert</dt><dd class="chiffre">2023</dd></div>
    </dl>
  </section>

  <div class="photo-large" data-parallaxe>
    <Photo nom="semis" alt="Jeunes pousses de blettes multicolores sous un tunnel de la ferme" sizes="100vw" largeurs={[480, 800, 1200, 1600, 2000]} prioritaire />
  </div>

  <!-- ENGAGEMENT -->
  <section class="wrap engagement" aria-labelledby="engagement-titre">
    <div class="engagement__gauche">
      <p class="eyebrow" id="engagement-titre" data-anim>La ferme Au Grand Jardin</p>
      <div class="engagement__tampon" data-anim="tampon" set:html={tamponSvg} />
    </div>
    <div class="engagement__droite">
      <p class="engagement__texte" data-anim>Pierre cultive dans le respect du sol : un paillage toujours, des haies, des fleurs pour les pollinisateurs. <span class="discret">Ce qui pousse ici suit les saisons, et c’est exactement ce que vous trouvez le samedi.</span></p>
      <ul class="cartes-douces" role="list" data-anim-groupe="pop">
        <li><span class="valeur">Bio</span><span>certifié par Ecocert depuis 2023</span></li>
        <li><span class="valeur" data-compteur>100&nbsp;%</span><span>de nos légumes cultivés à la ferme</span></li>
        <li><span class="valeur">Goût</span><span>des variétés testées et choisies pour leur saveur</span></li>
        <li><span class="valeur">PBI</span><span>des insectes prédateurs contre les pucerons, plutôt qu’un traitement</span></li>
      </ul>
      <div data-anim><a class="btn btn-secondaire btn-bloc engagement__btn" href="/la-ferme/">Découvrir la ferme<Icone nom="droite" taille={18} /></a></div>
    </div>
  </section>

  <!-- PRODUITS DE LA SEMAINE (ou pause, en mode fermé) -->
  {fermeture ? (
    <section class="section-sombre sur-sombre semaine semaine--pause" aria-labelledby="semaine-titre">
      <div class="wrap semaine__tete">
        <div class="semaine__titres" data-anim>
          <p class="eyebrow">La ferme fait une pause</p>
          <h2 id="semaine-titre">{reprise}</h2>
        </div>
      </div>
      <div class="wrap semaine__bas" data-anim>
        <p class="muted">{fermeture.message}</p>
        <div class="btns">
          <a class="btn btn-blanc btn-bloc" href="#sms">Recevoir la liste de la semaine</a>
          <a class="btn btn-contour-clair btn-bloc" href={ferme.facebook} rel="noopener"><Icone nom="facebook" taille={18} />Suivre la ferme sur Facebook</a>
        </div>
      </div>
    </section>
  ) : (
  <section class="section-sombre sur-sombre semaine" aria-labelledby="semaine-titre">
    <div class="wrap semaine__tete">
      <div class="semaine__titres" data-anim>
        <p class="eyebrow">Cette semaine à la ferme</p>
        <h2 id="semaine-titre">{v ? `Ce qui est prêt pour ${jourVente}` : 'Ce qui est prêt cette semaine'}</h2>
      </div>
      <div class="surtitre semaine__maj" data-anim><span class="point point-clair" aria-hidden="true"></span><p class="sm muted"><span class="seulement-ordi">Liste mise</span><span class="seulement-mobile">Mise</span> à jour {misAJour.virgule}</p></div>
    </div>
    <ul class="semaine__cartes defile" role="list" data-anim-groupe="cartes">
      {vedettes.map((p) => (
        <li>
          <a class="vedette" href={`/produits/#p-${p.id}`}>
            <img src={p.image.grand} srcset={`${p.image.petit} 400w, ${p.image.grand} 800w`} sizes="(min-width: 1100px) 308px, 260px" alt="" loading="lazy" decoding="async" width="308" height="400" />
            {p.estNouveau && <span class="chip chip-vif vedette__badge">Nouveau</span>}
            <span class="vedette__fleche" aria-hidden="true"><Icone nom="fleche" taille={18} /></span>
            <span class="vedette__texte">
              <span class="vedette__nom">{p.nom}</span>
              <span class="vedette__prix">{euros(p.prix.montant)} · {p.prix.unite}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="wrap semaine__bas" data-anim>
      <p class="muted">Et {nb - vedettes.length} autres produits : {autresTexte}. Prix TTC, vente à la ferme.</p>
      <a class="btn btn-blanc btn-bloc" href="/produits/">Voir toute la liste</a>
    </div>
  </section>
  )}

  <!-- QUATRE FAÇONS -->
  <section class="wrap facons" aria-labelledby="facons-titre">
    <div class="facons__tete" data-anim>
      <p class="eyebrow">À la ferme et au-delà</p>
      <h2 id="facons-titre">{commandesPdtOuvertes ? 'Quatre' : 'Trois'} façons de manger nos légumes</h2>
      <p class="muted seulement-ordi">{commandesPdtOuvertes
        ? 'Venez le samedi, commandez vos pommes de terre, recevez la liste de la semaine sur WhatsApp, ou faites-vous livrer si vous êtes un professionnel.'
        : 'Venez le samedi, recevez la liste de la semaine sur WhatsApp, ou faites-vous livrer si vous êtes un professionnel.'}</p>
    </div>
    <ul class="facons__grille" role="list" data-anim-groupe="monte">
      <li>
        <a class="facon" href="/horaires-contact/">
          <div class="photo facon__photo"><Photo nom="stand" alt="Le stand de la ferme, sous la tente, un samedi matin" sizes="(min-width: 1100px) 400px, 88px" largeurs={[176, 400, 800]} class="pos-stand" /></div>
          <div class="facon__texte">
            <div class="facon__titre"><h3>Vente à la ferme</h3><Icone nom="droite" taille={22} class="facon__fleche" /></div>
            <p class="muted facon__desc"><span class="seulement-ordi">{samediFerme ? `Tous les samedis de ${fmtHeure(samediFerme.debut)} à ${fmtHeure(samediFerme.fin)}, 43 rue Principale à Lostroff.` : 'À la ferme, 43 rue Principale à Lostroff.'} Les horaires de la semaine sont affichés en haut de chaque page.</span><span class="seulement-mobile">{samediFerme ? `Tous les samedis, ${plage(samediFerme)}, à Lostroff.` : 'À la ferme, à Lostroff.'}</span></p>
          </div>
          <span class="chip facon__chip">Chaque samedi</span>
          <Icone nom="chevron" taille={20} class="facon__chevron" />
        </a>
      </li>
      {commandesPdtOuvertes && <li>
        <a class="facon" href="/pommes-de-terre/">
          <div class="photo facon__photo"><Photo nom="pdt" alt="Pommes de terre de la ferme" sizes="(min-width: 1100px) 400px, 88px" largeurs={[176, 400, 800]} /></div>
          <div class="facon__texte">
            <div class="facon__titre"><h3>Pommes de terre en sacs</h3><Icone nom="droite" taille={22} class="facon__fleche" /></div>
            <p class="muted facon__desc"><span class="seulement-ordi">{pdt.varietes ? `${pdt.varietes} variétés ${pdt.formatsCarte}, commandées en ligne et retirées à la ferme.` : 'Commandées en ligne, retirées à la ferme.'}</span><span class="seulement-mobile">{pdtOuvert ? 'Commandes ouvertes en ligne.' : 'Commandes en ligne fermées pour le moment.'}</span></p>
          </div>
          <span class="chip facon__chip">{pdtOuvert ? 'Commandes ouvertes' : 'Commandes fermées pour le moment'}</span>
          <Icone nom="chevron" taille={20} class="facon__chevron" />
        </a>
      </li>}
      <li>
        <a class="facon" href="#sms">
          <div class="photo facon__photo"><Photo nom="tunnels-champ" alt="Les tunnels de la ferme au milieu des champs" sizes="(min-width: 1100px) 400px, 88px" largeurs={[176, 400, 800]} /></div>
          <div class="facon__texte">
            <div class="facon__titre"><h3>La liste sur WhatsApp</h3><Icone nom="droite" taille={22} class="facon__fleche" /></div>
            <p class="muted facon__desc"><span class="seulement-ordi">Chaque semaine, Pierre envoie la liste de ce qui est prêt sur WhatsApp, ou par SMS si vous n’avez pas WhatsApp.</span><span class="seulement-mobile">La liste chaque semaine, de début avril à fin décembre.</span></p>
          </div>
          <span class="chip facon__chip">Avril – décembre</span>
          <Icone nom="chevron" taille={20} class="facon__chevron" />
        </a>
      </li>
      <li>
        <a class="facon" href="/professionnels/">
          <div class="photo facon__photo"><Photo nom="pierre" alt="Pierre Fouquet, le maraîcher, sous un tunnel de la ferme" sizes="(min-width: 1100px) 400px, 88px" largeurs={[176, 400, 800]} class="pos-pierre" /></div>
          <div class="facon__texte">
            <div class="facon__titre"><h3>Restaurants et épiceries</h3><Icone nom="droite" taille={22} class="facon__fleche" /></div>
            <p class="muted facon__desc"><span class="seulement-ordi">Livraison chaque semaine selon nos récoltes. Grille tarifaire réservée aux professionnels.</span><span class="seulement-mobile">Livraison hebdomadaire, grille tarifaire pro.</span></p>
          </div>
          <span class="chip facon__chip">Professionnels</span>
          <Icone nom="chevron" taille={20} class="facon__chevron" />
        </a>
      </li>
    </ul>
  </section>

  <!-- VENIR À LA FERME -->
  <section class="wrap venir" aria-labelledby="venir-titre">
    <div class="carte-sable venir__carte" data-anim>
      <div class="photo venir__photo" data-anim="photo"><Photo nom="tunnel" alt="Un tunnel de culture de la ferme, vu de l’intérieur" sizes="(min-width: 1100px) 420px, calc(100vw - 64px)" largeurs={[400, 700, 900]} class="pos-tunnel" /></div>
      <div class="venir__texte">
        <div class="surtitre"><Icone nom="horloge" taille={18} /><p class="eyebrow" id="venir-titre">Venir à la ferme</p></div>
        {fermeture
          ? <p class="venir__quand">Ventes en pause<br />{fermeture.reprise ? `reprise le ${fermeture.repriseLong}` : 'reprise bientôt'}</p>
          : quand
            ? <p class="venir__quand"><span data-vente-sans-date={v.jour}>{quand.jour}</span><br />{quand.heures}</p>
            : <p class="venir__quand">Pas de vente cette semaine</p>}
        <div class="venir__adresse">
          <p class="lg fonce">{adresseComplete}</p>
          <p class="muted"><span class="seulement-ordi">Les horaires changent selon les saisons{marchesAffiches && ' et les marchés'}. Ils sont mis à jour ici chaque semaine, en même temps que la liste des produits.</span><span class="seulement-mobile sm">Horaires mis à jour ici chaque semaine, avec la liste des produits.</span></p>
        </div>
        <div class="btns">
          <a class="btn btn-primaire btn-bloc" href={ferme.itineraire} rel="noopener"><Icone nom="repere" taille={18} />Itinéraire</a>
          <a class="btn btn-secondaire btn-bloc" href={ferme.telephoneLien}><Icone nom="telephone" taille={18} />{ferme.telephone}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SMS -->
  <section class="sms sur-sombre" id="sms" aria-labelledby="sms-titre" data-parallaxe>
    <Photo nom="echange" alt="" sizes="100vw" largeurs={[480, 800, 1200, 1600, 2000]} class="sms__photo" />
    <div class="sms__voile" aria-hidden="true"></div>
    <div class="wrap sms__wrap">
      <div class="sms__contenu" data-anim-groupe="monte">
        <p class="eyebrow">Chaque semaine, un seul message</p>
        <h2 id="sms-titre">La liste des légumes, directement sur votre téléphone</h2>
        <p class="muted">De début avril à fin décembre, recevez la liste<span class="seulement-ordi"> de la semaine</span> sur WhatsApp, ou par SMS si vous n’avez pas WhatsApp.</p>
        <FormulaireSms source="accueil" variante="sombre" />
      </div>
    </div>
  </section>

  <QuestionsFrequentes page="Accueil" titre="Vos questions" />
</Base>

<style>
  /* Hero */
  .hero { padding-top: 36px; padding-bottom: 36px; display: flex; flex-direction: column; gap: 24px; }
  .hero__haut { display: contents; }
  .hero__principal { display: flex; flex-direction: column; gap: 24px; }
  .hero__intro--ordi { display: none; }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 16px; padding-top: 12px; }
  .stats > div { display: flex; flex-direction: column-reverse; gap: 4px; justify-content: flex-end; }
  .stats > .stat-ordi { display: none; }
  @media (min-width: 720px) { .stats { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 1100px) {
    .hero { padding-top: 72px; padding-bottom: 56px; gap: 56px; }
    .hero__haut { display: flex; justify-content: space-between; align-items: flex-end; gap: 50px; }
    .hero__principal { gap: 32px; max-width: 900px; flex: 1; }
    .hero__intro--mobile { display: none; }
    .hero__intro--ordi { display: block; width: 330px; flex: none; }
    .stats { display: flex; justify-content: space-between; padding-top: 0; }
    .stats > div, .stats > .stat-ordi { display: flex; width: 220px; gap: 8px; }
  }

  .photo-large { height: 300px; overflow: hidden; background: var(--sable); }
  .photo-large :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 30% 55%; }
  @media (min-width: 720px) { .photo-large { height: 440px; } }
  @media (min-width: 1100px) { .photo-large { height: 620px; } .photo-large :global(img) { object-position: 50% 55%; } }

  /* Engagement */
  .engagement { padding-top: 64px; padding-bottom: 64px; display: flex; flex-direction: column; gap: 28px; }
  .engagement__gauche { display: flex; justify-content: space-between; align-items: center; }
  .engagement__tampon { width: 56px; opacity: 0.9; }
  .engagement__tampon :global(svg) { width: 100%; height: auto; }
  .engagement__droite { display: flex; flex-direction: column; gap: 28px; }
  .engagement__texte { font-size: 24px; line-height: 32px; letter-spacing: -0.02em; color: var(--texte); }
  .cartes-douces { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .cartes-douces li { height: 150px; border-radius: var(--rayon); background: var(--sable); padding: 16px; display: flex; flex-direction: column; justify-content: space-between; font-size: 14px; line-height: 20px; color: var(--gris-fonce); }
  .cartes-douces .valeur { font-size: 32px; line-height: 40px; letter-spacing: -0.03em; color: var(--texte); }
  @media (min-width: 1100px) {
    .engagement { padding-top: 112px; padding-bottom: 112px; flex-direction: row; justify-content: space-between; gap: 40px; }
    .engagement__gauche { flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 24px; width: 300px; flex: none; }
    .engagement__tampon { width: 120px; }
    .engagement__droite { width: 860px; gap: 48px; }
    .engagement__texte { font-size: 36px; line-height: 46px; letter-spacing: -0.025em; }
    .cartes-douces { grid-template-columns: repeat(4, 1fr); }
    .cartes-douces li { height: 212px; padding: 18px; }
    .cartes-douces .valeur { font-size: 44px; line-height: 52px; }
    .engagement__btn { width: auto; }
    .engagement__btn :global(svg) { order: 1; }
  }
  .engagement__btn :global(svg) { order: -1; }

  /* Produits de la semaine */
  .semaine { padding-top: 64px; padding-bottom: 64px; display: flex; flex-direction: column; gap: 28px; }
  .semaine__tete { display: flex; flex-direction: column; gap: 14px; }
  .semaine__titres { display: flex; flex-direction: column; gap: 14px; }
  .semaine__maj { gap: 8px; }
  .semaine__bas { display: flex; flex-direction: column; gap: 20px; }
  @media (min-width: 1100px) {
    .semaine { padding-top: 104px; padding-bottom: 96px; gap: 56px; }
    .semaine__tete { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    .semaine__titres { gap: 18px; width: 720px; }
    .semaine__maj { gap: 10px; }
    .semaine__maj .muted { color: var(--blanc); }
    .semaine__cartes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; overflow: visible; padding-inline: var(--gouttiere); max-width: var(--max); margin-inline: auto; width: 100%; }
    .semaine__bas { flex-direction: row; justify-content: space-between; align-items: center; }
    .semaine__bas p { width: 620px; color: var(--blanc); }
    .semaine__bas .btn { width: auto; }
    .semaine--pause { gap: 32px; }
    .semaine--pause .semaine__bas { flex-direction: column; align-items: flex-start; gap: 28px; }
    .semaine--pause .semaine__bas p { width: 760px; font-size: 20px; line-height: 30px; }
  }

  /* Quatre façons */
  .facons { padding-top: 64px; padding-bottom: 64px; display: flex; flex-direction: column; gap: 20px; }
  .facons__tete { display: flex; flex-direction: column; gap: 14px; }
  .facons__grille { border-top: 1px solid var(--ligne); }
  .facon { display: grid; grid-template-columns: 88px 1fr 20px; gap: 14px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--ligne); }
  .facon__photo { width: 88px; height: 88px; }
  .facon__texte { display: flex; flex-direction: column; gap: 4px; }
  .facon__titre h3 { font-size: 18px; line-height: 26px; letter-spacing: 0; }
  .facon__desc { font-size: 14px; line-height: 20px; }
  .facon :global(.facon__fleche), .facon__chip { display: none; }
  .facon :global(.facon__chevron) { color: var(--texte); }
  @media (min-width: 720px) and (max-width: 1099px) { .facon { grid-template-columns: 140px 1fr 20px; } .facon__photo { width: 140px; height: 105px; } }
  @media (min-width: 1100px) {
    .facons { padding-top: 112px; padding-bottom: 112px; flex-direction: row; justify-content: space-between; gap: 40px; }
    .facons__tete { width: 360px; gap: 18px; flex: none; }
    .facons__tete h2 { font-size: 40px; line-height: 48px; text-wrap: wrap; }
    .facons__grille { border-top: 0; width: 816px; display: grid; grid-template-columns: 400px 400px; gap: 56px 16px; align-content: start; }
    .facon { display: flex; flex-direction: column; align-items: stretch; gap: 18px; padding: 0; border-bottom: 0; }
    .facon__photo { width: 400px; height: 300px; }
    .facon__texte { gap: 8px; }
