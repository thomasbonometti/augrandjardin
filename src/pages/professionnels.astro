---
// Professionnels — frames Figma 17:2 (desktop) et 42:2 (mobile)
// Espace pro en veille jusqu'au printemps 2027 (revue de Pierre du 26/10/2026) : case « Espace pro ouvert »
// de Réglages du site décochée → pas d'étapes ni de formulaires, un encart pour contacter Pierre en haut.
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Photo from '../components/Photo.astro';
import { ferme } from '../data/ferme.js';
import { restaurants } from '../lib/donnees.js';
import QuestionsFrequentes from '../components/QuestionsFrequentes.astro';
import { produits, fermeture, espaceProOuvert } from '../lib/donnees.js';
import { fileAriane } from '../lib/seo.js';
---
<Base
  titre="Professionnels — légumes bio de Lostroff livrés chaque semaine | Au Grand Jardin"
  description="Restaurants, épiceries, collectivités : Au Grand Jardin livre ses légumes bio de saison chaque semaine autour de Lostroff (Moselle). Grille tarifaire pro, réponse sous 48 h."
  page="pros"
  schema={fileAriane([{ nom: 'Professionnels', url: '/professionnels/' }])}
>
  <section class="wrap hero">
    <div class="hero__texte">
      <p class="eyebrow" data-anim>Restaurants · épiceries · collectivités</p>
      <h1 class="h1-page" data-anim="mots">Des légumes bio de Lostroff, livrés chaque semaine</h1>
      <p class="lg muted" data-anim>Vous cuisinez local et de saison ? On vous propose une offre selon nos récoltes et vos besoins, avec une livraison hebdomadaire.</p>
      {espaceProOuvert ? (
        <div class="btns" data-anim>
          <a class="btn btn-primaire btn-bloc" href="#demande">Demander un accès</a>
          <a class="btn btn-secondaire btn-bloc" href="#acces"><Icone nom="cadenas" taille={18} />J’ai déjà un accès</a>
        </div>
      ) : (
        <div class="contact-pro carte-sable" data-anim data-contact-pro>
          <p class="contact-pro__titre">Pour travailler avec la ferme, contactez Pierre</p>
          <p class="muted contact-pro__texte">Vos volumes, vos jours de livraison, les produits qui comptent pour votre carte : Pierre vous répond sous 48&nbsp;h.</p>
          <div class="btns">
            <a class="btn btn-primaire btn-bloc" href={ferme.telephoneLien}><Icone nom="telephone" taille={18} />{ferme.telephone}</a>
            <a class="btn btn-secondaire btn-bloc" href={`mailto:${ferme.email}?subject=${encodeURIComponent('Livraison de légumes pour un professionnel')}`}>Écrire à Pierre</a>
          </div>
        </div>
      )}
      <dl class="stats" data-anim-groupe="monte">
        <div><dt class="sm muted">pour vous répondre</dt><dd class="chiffre" data-compteur>48&nbsp;h</dd></div>
        {fermeture
          ? <div><dt class="sm muted">reprise des ventes</dt><dd class="chiffre">{fermeture.reprise ? fermeture.repriseChiffre : 'Bientôt'}</dd></div>
          : <div><dt class="sm muted">produits cette semaine</dt><dd class="chiffre" data-compteur>{produits.length}</dd></div>}
        <div><dt class="sm muted">restaurants clients</dt><dd class="chiffre" data-compteur>{restaurants.length}</dd></div>
      </dl>
    </div>
    <div class="photo hero__photo" data-anim="photo"><Photo nom="echange" alt="Pierre échange avec un client sous un tunnel de la ferme" sizes="(min-width: 1100px) 580px, calc(100vw - 40px)" largeurs={[400, 700, 1000, 1400]} prioritaire /></div>
  </section>

  <section class="wrap clients" aria-labelledby="clients-titre">
    <div class="clients__bloc">
      <h2 class="eyebrow" id="clients-titre">Ils cuisinent nos légumes</h2>
      <ul class="clients__liste" role="list" data-anim-groupe="pop">{restaurants.map((r) => <li class="chip chip-contour">{r.court}</li>)}</ul>
    </div>
  </section>

  {espaceProOuvert && <>
  <section class="section-sombre sur-sombre etapes" aria-labelledby="etapes-titre">
    <div class="wrap etapes__wrap">
      <div class="etapes__tete" data-anim>
        <p class="eyebrow">Comment ça marche</p>
        <h2 id="etapes-titre">Trois étapes pour travailler ensemble</h2>
      </div>
      <ol class="etapes__liste" data-anim-groupe="pop">
        <li><p class="etapes__num" aria-hidden="true">01</p><h3>On fait connaissance</h3><p class="muted">Vos volumes, votre adresse de livraison, les produits qui comptent pour votre carte.</p></li>
        <li><p class="etapes__num" aria-hidden="true">02</p><h3>Vous recevez votre accès</h3><p class="muted">Votre espace pro, avec vos prix. Chaque jeudi, la grille de la semaine arrive aussi par mail.</p></li>
        <li><p class="etapes__num" aria-hidden="true">03</p><h3>Vous commandez</h3><p class="muted">En ligne, jusqu’au samedi 18&nbsp;h, ou par téléphone. Pierre livre le lundi.</p></li>
      </ol>
    </div>
  </section>

  <section class="wrap formulaires">
    <form class="demande encart-blanc" data-anim id="demande" action="/api/demande-pro" method="post" data-form-api novalidate aria-labelledby="demande-titre">
      <h2 class="formulaires__titre" id="demande-titre">Demander un accès</h2>
      <p class="muted demande__intro">Pierre vous rappelle sous 48 h pour parler de vos besoins.</p>
      <div class="demande__champs">
        <div class="champ"><label for="d-nom">Votre nom</label><input class="saisie" id="d-nom" name="nom" autocomplete="name" placeholder="Camille Durand" required maxlength="120" /></div>
        <div class="champ"><label for="d-etab">Établissement</label><input class="saisie" id="d-etab" name="etablissement" autocomplete="organization" placeholder="Restaurant, épicerie…" required maxlength="160" /></div>
        <div class="champ"><label for="d-tel">Téléphone</label><input class="saisie" id="d-tel" name="telephone" type="tel" inputmode="tel" autocomplete="tel" placeholder="06 12 34 56 78" required pattern="[0-9 +().\-]{9,20}" /></div>
        <div class="champ"><label for="d-mail">E-mail</label><input class="saisie" id="d-mail" name="email" type="email" inputmode="email" autocomplete="email" placeholder="contact@etablissement.fr" required maxlength="160" /></div>
      </div>
      <div class="champ"><label for="d-besoins">Vos besoins</label><textarea class="saisie" id="d-besoins" name="besoins" placeholder="Volumes, jours de livraison, produits recherchés…" maxlength="1800"></textarea></div>
      <div class="piege" aria-hidden="true"><label>Site web <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
      <div><button class="btn btn-primaire btn-bloc demande__bouton" type="submit">Envoyer la demande</button></div>
      <p class="message-form" role="status" aria-live="polite"></p>
    </form>

    <form class="acces carte-sable" data-anim id="acces" action="/api/agj/pro/login" method="post" data-form-api data-redirection="/pro/tarifs/" novalidate aria-labelledby="acces-titre">
      <span class="acces__icone"><Icone nom="cadenas" taille={28} /></span>
      <h2 class="formulaires__titre" id="acces-titre">Déjà client ?</h2>
      <p class="muted acces__intro">Connectez-vous pour voir vos prix de la semaine et passer votre commande.</p>
      <div class="champ"><label for="acces-email">E-mail</label><input class="saisie" id="acces-email" name="email" type="email" inputmode="email" autocomplete="username" placeholder="contact@etablissement.fr" required maxlength="160" /></div>
      <div class="champ"><label for="acces-mdp">Mot de passe</label><input class="saisie" id="acces-mdp" name="password" type="password" autocomplete="current-password" placeholder="••••••••" required /></div>
      <button class="btn btn-noir btn-bloc" type="submit">Voir mes prix</button>
      <p class="message-form" role="status" aria-live="polite"></p>
      <p class="sm muted">Votre e-mail et votre mot de passe vous ont été envoyés par la ferme. Oublié ? Appelez Pierre au {ferme.telephone}.</p>
    </form>
  </section>
  </>}

  <QuestionsFrequentes page="Professionnels" titre="Travailler avec la ferme" />
</Base>

<style>
  .hero { padding-top: 32px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 22px; }
  .hero__texte { display: contents; }
  .hero__texte > * { order: 0; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding-top: 8px; }
  .stats > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 4px; }
  .hero__photo { height: 300px; }
  .hero__photo :global(img) { object-position: 62% 45%; }
  @media (min-width: 1100px) {
    .hero { padding-top: 56px; padding-bottom: 96px; flex-direction: row; align-items: center; gap: 80px; }
    .hero__texte { display: flex; flex-direction: column; gap: 32px; width: 620px; }
    .hero .btns .btn { width: auto; }
    .stats { display: flex; gap: 40px; padding-top: 16px; }
    .stats > div { width: 160px; gap: 8px; }
    .hero__photo { width: 580px; height: 680px; flex: none; }
    .hero__photo :global(img) { object-position: 62% 50%; }
  }

  .contact-pro { display: flex; flex-direction: column; gap: 12px; padding: 20px; }
  .contact-pro__titre { font-size: 20px; line-height: 28px; letter-spacing: -0.02em; color: var(--texte); }
  .contact-pro__texte { font-size: 15px; line-height: 22px; }
  .contact-pro .btns { padding-top: 4px; }
  @media (min-width: 1100px) {
    .contact-pro { padding: 28px; gap: 14px; }
    .contact-pro__titre { font-size: 24px; line-height: 32px; }
    .contact-pro__texte { font-size: 16px; line-height: 24px; }
    .contact-pro .btns .btn { width: auto; }
  }

  .clients { padding-bottom: 48px; }
  .clients__bloc { display: flex; flex-direction: column; gap: 14px; padding-top: 28px; border-top: 1px solid var(--bordure-soutenue); }
  .clients h2.eyebrow { font-size: 13px; line-height: 20px; letter-spacing: 0.16em; }
  .clients__liste { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .clients__liste .chip { height: 44px; padding: 0 16px; font-size: 16px; color: var(--texte); white-space: normal; }
  @media (min-width: 720px) { .clients__liste { flex-direction: row; flex-wrap: wrap; } }
  @media (min-width: 1100px) {
    .clients { padding-bottom: 96px; }
    .clients__bloc { gap: 20px; padding-top: 40px; }
    .clients__liste { gap: 12px; }
    .clients__liste .chip { height: 52px; padding: 0 22px; font-size: 18px; }
  }

  .etapes__wrap { padding-top: 56px; padding-bottom: 56px; display: flex; flex-direction: column; gap: 32px; }
  .etapes__tete { display: flex; flex-direction: column; gap: 14px; }
  .etapes__liste { list-style: none; display: flex; flex-direction: column; gap: 32px; }
  .etapes__liste li { display: flex; flex-direction: column; gap: 8px; }
  .etapes__num { font-size: 40px; line-height: 48px; color: var(--vert-clair); }
  @media (min-width: 1100px) {
    .etapes__wrap { padding-top: 104px; padding-bottom: 104px; gap: 56px; }
    .etapes__tete { gap: 18px; }
    .etapes__liste { flex-direction: row; gap: 40px; }
    .etapes__liste li { width: 400px; gap: 14px; }
    .etapes__num { font-size: 56px; line-height: 64px; color: var(--blanc); }
  }

  .formulaires { padding-top: 56px; padding-bottom: 64px; display: flex; flex-direction: column; gap: 16px; }
  .formulaires__titre { font-size: 24px; line-height: 30px; letter-spacing: -0.02em; }
  .demande, .acces { display: flex; flex-direction: column; gap: 18px; padding: 24px; scroll-margin-top: 16px; }
  .demande__intro, .acces__intro { font-size: 14px; line-height: 20px; }
  .demande__champs { display: flex; flex-direction: column; gap: 18px; }
  .acces { gap: 16px; }
  .acces__icone { color: var(--vert-foret); display: block; }
  .acces__icone :global(svg) { width: 26px; height: 26px; }
  .formulaires .message-form:empty { display: none; }
  @media (min-width: 720px) { .demande__champs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; } }
  @media (min-width: 1100px) {
    .formulaires { padding-top: 112px; padding-bottom: 112px; flex-direction: row; align-items: stretch; }
    .formulaires__titre { font-size: 32px; line-height: 40px; letter-spacing: -0.03em; }
    .demande { width: 808px; flex: none; padding: 40px; gap: 24px; }
    .demande__champs { row-gap: 24px; }
    .demande__intro, .acces__intro { font-size: 16px; line-height: 24px; }
    .demande__bouton { width: auto; }
    .acces { flex: 1; padding: 40px; gap: 20px; }
    .acces__icone :global(svg) { width: 28px; height: 28px; }
  }
</style>
