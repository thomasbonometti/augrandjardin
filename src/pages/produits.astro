---
// Produits de la semaine — frames Figma 14:2 (desktop) et 39:2 (mobile). Liste lue dans Notion à la construction.
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import ProduitCarte from '../components/ProduitCarte.astro';
import PanneauProduit from '../components/PanneauProduit.astro';
import FormulaireSms from '../components/FormulaireSms.astro';
import EncartFermeture from '../components/EncartFermeture.astro';
import QuestionsFrequentes from '../components/QuestionsFrequentes.astro';
import { produits, rayons, prochaineVente as v, misAJour, nbQuantiteLimitee, fermeture, moisCourant } from '../lib/donnees.js';
import { fileAriane } from '../lib/seo.js';

const nb = produits.length;
const jour = v ? v.jour.toLowerCase() : 'samedi';
const quand = v ? `${v.jourDate.replace(/^./, (c) => c.toUpperCase())}, ${v.heures}` : null;
const reprise = fermeture?.reprise ? `reprise le ${fermeture.repriseLong}` : 'reprise bientôt';
const description = fermeture
  ? `Les ventes de la ferme Au Grand Jardin sont en pause, ${reprise}. Inscrivez-vous à la liste de la semaine pour la recevoir dès la reprise. 43 rue Principale à Lostroff.`
  : `Les ${nb} produits en vente à la ferme Au Grand Jardin cette semaine, avec leurs prix TTC${v ? `. Vente ${v.jourDate} de ${v.heures}` : ''}, 43 rue Principale à Lostroff.`;
---
<Base
  titre={`Produits de la semaine — légumes bio à Lostroff | Au Grand Jardin`}
  description={description}
  page="produits"
  schema={fileAriane([{ nom: 'Produits de la semaine', url: '/produits/' }])}
>
  <section class="wrap tete">
    {fermeture
      ? <div class="surtitre" data-anim><span class="point" aria-hidden="true"></span><p class="eyebrow">Ventes en pause</p></div>
      : <div class="surtitre" data-anim><span class="point" aria-hidden="true"></span><p class="eyebrow"><span class="seulement-ordi">Mis à jour {misAJour.texte}</span><span class="seulement-mobile">Mis à jour {misAJour.court}, {misAJour.heure}</span></p></div>}
    <div class="tete__ligne">
      <div class="tete__textes">
        <h1 data-anim="mots">Produits de la semaine</h1>
        {fermeture
          ? <p class="lg muted tete__intro" data-anim>Pas de liste en ce moment : la ferme fait une pause.</p>
          : <p class="lg muted tete__intro" data-anim>{nb} produits à venir chercher à la ferme {jour}. <span class="seulement-ordi">Les prix sont TTC.</span><span class="seulement-mobile">Prix TTC.</span> Ceux marqués « Quantité limitée » partent vite : venez tôt.</p>}
      </div>
      {!fermeture && (
        <div class="tete__infos" data-anim-groupe="pop">
          {quand && <span class="chip chip-contour"><Icone nom="horloge" taille={16} />{quand}</span>}
          {nbQuantiteLimitee > 0 && <span class="chip">{nbQuantiteLimitee} produit{nbQuantiteLimitee > 1 ? 's' : ''} en quantité limitée</span>}
          <a class="chip chip-contour lien-saison" href="/calendrier-de-saison/"><Icone nom="saison" taille={16} />Calendrier de saison</a>
        </div>
      )}
    </div>
  </section>

  {fermeture && <section class="wrap pause" aria-label="Ventes en pause" data-anim><EncartFermeture lienSms="#sms" /></section>}

  {!fermeture && <>
  <nav class="filtres" aria-label="Rayons">
    <div class="filtres__liste defile">
      <a class="chip filtre" href="#produits" data-filtre="" aria-current="true">Tout <span class="compte">{nb}</span></a>
      {rayons.map((r) => (
        <a class="chip filtre" href={`#${r.slug}`} data-filtre={r.slug}>{r.titre} <span class="compte">{r.produits.length}</span></a>
      ))}
    </div>
  </nav>

  <div class="wrap rayons" id="produits">
    {rayons.map((r) => (
      <section class="rayon" id={r.slug} data-rayon={r.slug} aria-labelledby={`t-${r.slug}`}>
        <div class="rayon__tete" data-anim>
          <h2 class="rayon__titre" id={`t-${r.slug}`}>{r.titre}</h2>
          <p class="muted rayon__compte">{r.produits.length} produit{r.produits.length > 1 ? 's' : ''}</p>
        </div>
        <ul class="grille" role="list" data-anim-groupe="pop">
          {r.produits.map((p) => <ProduitCarte p={p} />)}
        </ul>
      </section>
    ))}
  </div>

  <div class="panneaux">
    {rayons.flatMap((r) => r.produits.map((p) => <PanneauProduit p={p} rayon={r.titre} vente={v} mois={moisCourant} />))}
  </div>
  </>}

  <section class="wrap sms" id="sms" aria-labelledby="sms-titre">
    <div class="carte-sable sms__carte" data-anim>
      <div class="sms__textes">
        <h2 class="sms__titre" id="sms-titre">Recevez la liste chaque semaine</h2>
        <p class="muted sms__texte">Sur WhatsApp, ou par SMS si vous n’avez pas WhatsApp, de début avril à fin décembre. Pas de réservation : la récolte est en vente à la ferme le {jour}.</p>
      </div>
      <FormulaireSms source="produits" variante="clair" />
    </div>
  </section>

  <QuestionsFrequentes page="Produits" titre="Avant de venir" />
</Base>

<script>
  // Filtres par rayon : sans JavaScript, ce sont des liens vers chaque rayon.
  const filtres = [...document.querySelectorAll<HTMLAnchorElement>('.filtre')];
  const rayons = [...document.querySelectorAll<HTMLElement>('[data-rayon]')];
  const appliquer = (slug: string) => {
    filtres.forEach((f) => f.setAttribute('aria-current', String(f.dataset.filtre === slug)));
    rayons.forEach((r) => { r.hidden = !!slug && r.dataset.rayon !== slug; });
  };
  filtres.forEach((f) => f.addEventListener('click', (e) => {
    e.preventDefault();
    appliquer(f.dataset.filtre || '');
    history.replaceState(null, '', f.dataset.filtre ? `#${f.dataset.filtre}` : location.pathname);
    document.getElementById('produits')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  const depart = location.hash.slice(1);
  if (depart && rayons.some((r) => r.dataset.rayon === depart)) appliquer(depart);
</script>

<script>
  // Panneaux des produits (lot 3) : un <dialog> par produit, ouvert depuis le nom de la carte (#ancre).
  // L'adresse suit le panneau (/produits/#carotte-vrac) : « Retour » le ferme, un lien partagé l'ouvre.
  // Fermeture : croix, Échap ou clic sur le voile ; le focus revient sur la carte.
  const panneaux = new Map([...document.querySelectorAll<HTMLDialogElement>('dialog[data-panneau]')].map((d) => [d.id, d]));
  const lienDe = (id: string) => document.querySelector<HTMLAnchorElement>(`.carte-produit__lien[href="#${CSS.escape(id)}"]`);
  let retour: HTMLElement | null = null;
  const ouvrir = (d: HTMLDialogElement, depuis: HTMLElement | null) => {
    if (d.open) return;
    for (const autre of panneaux.values()) if (autre.open) autre.close();
    retour = depuis ?? lienDe(d.id);
    d.showModal();
    d.scrollTop = 0;
  };
  for (const d of panneaux.values()) {
    d.addEventListener('close', () => {
      // Fermé par la croix, Échap ou le voile : l'adresse revient à la page
      if (location.hash === `#${d.id}`) {
        if (history.state?.panneau === d.id) history.back();
        else history.replaceState(null, '', location.pathname + location.search);
      }
      retour?.focus({ preventScroll: false });
      retour = null;
    });
    d.addEventListener('click', (e) => {
      // Le corps du panneau remplit le <dialog> : un clic sur le dialog lui-même est un clic sur le voile
      if (e.target === d || (e.target as Element).closest('[data-fermer]')) d.close();
    });
  }
  document.addEventListener('click', (e) => {
    const lien = (e.target as Element).closest<HTMLAnchorElement>('.carte-produit__lien');
    if (!lien || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const d = panneaux.get(lien.hash.slice(1));
    if (!d) return;
    e.preventDefault();
    history.pushState({ panneau: d.id }, '', `#${d.id}`);
    ouvrir(d, lien);
  });
  window.addEventListener('popstate', () => {
    const d = panneaux.get(location.hash.slice(1));
    if (d) ouvrir(d, null);
    else for (const autre of panneaux.values()) if (autre.open) autre.close();
  });
  // Arrivée par un lien partagé ou depuis le calendrier de saison
  const auDepart = panneaux.get(decodeURIComponent(location.hash.slice(1)));
  if (auDepart) {
    lienDe(auDepart.id)?.closest('.carte-produit')?.scrollIntoView({ block: 'center' });
    ouvrir(auDepart, null);
  }
</script>

<style>
  .tete { padding-top: 32px; padding-bottom: 24px; display: flex; flex-direction: column; gap: 18px; }
  .tete .surtitre { gap: 8px; }
  .tete__ligne { display: flex; flex-direction: column; gap: 18px; }
  .tete__textes { display: flex; flex-direction: column; gap: 18px; }
  .tete__intro { font-size: 16px; line-height: 24px; }
  .tete__infos { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .tete__infos .chip { height: 36px; font-size: 14px; }
  .lien-saison:hover { border-color: var(--texte); }
  @media (min-width: 1100px) {
    .tete { padding-top: 64px; padding-bottom: 32px; gap: 28px; }
    .tete .surtitre { gap: 10px; }
    .tete__ligne { flex-direction: row; justify-content: space-between; align-items: flex-end; gap: 40px; }
    .tete__textes { width: 760px; gap: 20px; }
    .tete__intro { font-size: 20px; line-height: 30px; }
    .tete__infos { align-items: flex-end; gap: 10px; }
    .tete__infos .chip { height: 40px; }
  }

  .filtres { border-top: 1px solid var(--bordure-claire); border-bottom: 1px solid var(--bordure-claire); background: var(--creme); }
  .filtres__liste { padding-top: 12px; padding-bottom: 12px; gap: 8px; max-width: var(--max); margin-inline: auto; }
  .filtre { height: 38px; padding: 0 14px; font-size: 14px; background: transparent; border: 1px solid var(--bordure-soutenue); }
  .filtre .compte { color: var(--discret-lisible); margin-left: 2px; }
  .filtre[aria-current='true'] { background: var(--vert-foret); border-color: var(--vert-foret); color: var(--blanc); }
  .filtre[aria-current='true'] .compte { color: var(--blanc); opacity: 0.85; }
  .filtre:hover { border-color: var(--texte); }
  @media (min-width: 1100px) {
    .filtres__liste { padding-top: 16px; padding-bottom: 16px; flex-wrap: wrap; overflow: visible; }
    .filtre { height: 40px; padding: 0 16px; }
  }

  .rayons { padding-bottom: 64px; }
  .rayon { padding-top: 40px; display: flex; flex-direction: column; gap: 18px; scroll-margin-top: 12px; }
  .rayon__tete { display: flex; gap: 10px; align-items: baseline; }
  .rayon__titre { font-size: 24px; line-height: 30px; letter-spacing: -0.02em; }
  .rayon__compte { font-size: 14px; line-height: 20px; }
  .grille { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 16px; }
  .grille :global(.carte-produit__nom) { letter-spacing: 0; }
  @media (min-width: 720px) { .grille { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 20px; } }
  @media (min-width: 1100px) {
    .rayons { padding-bottom: 112px; }
    .rayon { padding-top: 56px; gap: 28px; }
    .rayon__tete { gap: 12px; }
    .rayon__titre { font-size: 32px; line-height: 40px; letter-spacing: -0.03em; }
    .rayon__compte { font-size: 16px; line-height: 24px; }
    .grille { grid-template-columns: repeat(4, 302px); gap: 40px 24px; }
  }

  .pause { padding-bottom: 48px; }
  @media (min-width: 1100px) { .pause { padding-bottom: 96px; } }

  .sms { padding-bottom: 64px; }
  .sms__carte { display: flex; flex-direction: column; gap: 14px; padding: 24px; }
  .sms__textes { display: flex; flex-direction: column; gap: 14px; }
  .sms__titre { font-size: 24px; line-height: 30px; letter-spacing: -0.02em; }
  .sms__texte { font-size: 14px; line-height: 20px; }
  @media (min-width: 1100px) {
    .sms { padding-bottom: 112px; }
    .sms__carte { flex-direction: row; justify-content: space-between; align-items: center; padding: 48px; }
    .sms__textes { width: 560px; }
    .sms__titre { font-size: 32px; line-height: 40px; letter-spacing: -0.03em; }
    .sms__texte { font-size: 16px; line-height: 24px; }
  }
</style>
